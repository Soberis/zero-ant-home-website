# ============================================================
# ZeroAnt 官网 — 性能优化版 Nginx 配置
# 基于 nginx.conf.template，增加缓存/gzip/安全头/TLS 优化
# 部署时替换 {{SERVER_NAME}} 为实际域名
# ============================================================

# HTTP → HTTPS 重定向
server {
    listen 80;
    server_name {{SERVER_NAME}};
    charset utf-8;

    # 所有 HTTP 请求 301 到 HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{SERVER_NAME}};

    client_max_body_size 30M;
    client_header_buffer_size 16K;
    large_client_header_buffers 4 64K;

    root /mnt/disk1/zeroant/home_web;
    index index.html;

    # ---- TLS 优化 ----
    ssl_certificate     cert/zeroant.com.pem;
    ssl_certificate_key cert/zeroant.com.key;

    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # TLS 1.2 + 1.3（如 Nginx 版本不支持 TLSv1.3 可移除）
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # OCSP Stapling（如 CA 支持）
    # ssl_stapling on;
    # ssl_stapling_verify on;
    # resolver 8.8.8.8 8.8.4.4 valid=300s;

    # ---- 安全头 ----
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # HSTS — 仅在确认 HTTPS 全站可用后启用
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # ---- Gzip 压缩 ----
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/javascript
        application/json
        application/xml
        application/rss+xml
        application/atom+xml
        image/svg+xml
        font/woff2
        font/woff
        application/font-woff2
        application/font-woff;

    # ---- Brotli 压缩（需 ngx_brotli 模块）----
    # 如已安装 ngx_brotli，取消以下注释可获得比 gzip 更好的压缩率
    # brotli on;
    # brotli_comp_level 6;
    # brotli_types text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml font/woff2;

    # ---- 静态资源长缓存（Vite 构建产物带 hash）----
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # 保留安全头（add_header 在 location 块中会覆盖上层）
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        try_files $uri =404;
    }

    # ---- Responsive 图片缓存 ----
    location /responsive/ {
        expires 6M;
        add_header Cache-Control "public";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ---- 字体文件缓存 ----
    location ~* \.(woff2?|ttf|otf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header Access-Control-Allow-Origin "*";
        try_files $uri =404;
    }

    # ---- 图片缓存（非 assets 和 responsive 目录）----
    location ~* \.(png|jpg|jpeg|gif|webp|svg|ico)$ {
        expires 3M;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # ---- 旧产品路由静态重定向 ----
    location ~ ^/(en/)?(system-products|robot-products)(/.*)?$ {
        return 301 /$1products;
    }

    # ---- 静态路由处理 ----
    location / {
        # 仅对已预渲染页面放行，未知路径直接 404，避免坏链接被索引
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri $uri/ =404;
    }
}
