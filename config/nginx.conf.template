server {
    listen 80;
    server_name {{SERVER_NAME}};
    charset utf-8;

    # 静态文件路径（指向 Vite 构建后的 dist 目录）
    root /mnt/disk1/zeroant/home_web;
    index index.html;

    # 启用 gzip 压缩
    gzip on;
    gzip_types text/css application/javascript application/font-woff application/font-woff2 font/woff font/woff2;

    # 字体文件MIME类型配置
    location ~* \.(woff|woff2|ttf|eot|svg)$ {
        add_header Access-Control-Allow-Origin *;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 处理 SPA 路由：所有路由返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 生产环境开启 HTTP 跳转 HTTPS
    # {{REWRITE_HTTPS}}
}

server {
    listen 443 ssl;
    server_name {{SERVER_NAME}};
    client_max_body_size 30M;
    client_header_buffer_size 16K;
    large_client_header_buffers 4 64K;

    root /mnt/disk1/zeroant/home_web;
    index index.html;

    ssl_certificate cert/zeroant.com.pem;
    ssl_certificate_key cert/zeroant.com.key;

    ssl_session_timeout 5m;
    ssl_protocols SSLv3 TLSv1 TLSv1.1 TLSv1.2;
    ssl_ciphers "HIGH:!aNULL:!MD5 or HIGH:!aNULL:!MD5:!3DES";
    ssl_prefer_server_ciphers on;

    gzip on;
    gzip_types text/css application/javascript application/font-woff application/font-woff2 font/woff font/woff2;

    # 字体文件MIME类型配置
    location ~* \.(woff|woff2|ttf|eot|svg)$ {
        add_header Access-Control-Allow-Origin *;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}