server {
    listen 80;
    server_name {{SERVER_NAME}};
    charset utf-8;

    # 静态文件路径（指向 Vite 构建后的 dist 目录）
    root /mnt/disk1/zeroant/home_web;
    index index.html;

    # 启用 gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/xml+rss
        application/json
        application/font-woff
        application/font-woff2
        font/woff
        font/woff2
        image/svg+xml;

    # 静态资源缓存策略
    location ~* \.(woff|woff2|ttf|eot|otf|svg)$ {
        add_header Access-Control-Allow-Origin *;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # 图片资源缓存
    location ~* \.(jpg|jpeg|png|gif|ico|webp|avif)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # CSS和JS文件缓存
    location ~* \.(css|js)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # HTML文件缓存（较短缓存时间）
    location ~* \.html$ {
        expires 1h;
        add_header Cache-Control "public, no-cache";
    }

    # 处理 SPA 路由：所有路由返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # 生产环境开启 HTTP 跳转 HTTPS
    # {{REWRITE_HTTPS}}
}

server {
    listen 443 ssl;
    server_name {{SERVER_NAME}};
    client_max_body_size 30M;
    client_header_buffer_size 16K;
    large_client_header_buffers 4 64K;

    root /mnt/disk1/zeroant/home_web;
    index index.html;

    ssl_certificate cert/zeroant.com.pem;
    ssl_certificate_key cert/zeroant.com.key;

    ssl_session_timeout 5m;
    ssl_protocols SSLv3 TLSv1 TLSv1.1 TLSv1.2;
    ssl_ciphers "HIGH:!aNULL:!MD5 or HIGH:!aNULL:!MD5:!3DES";
    ssl_prefer_server_ciphers on;

    gzip on;
    gzip_types text/css application/javascript application/font-woff application/font-woff2 font/woff font/woff2;

    # 字体文件MIME类型配置
    location ~* \.(woff|woff2|ttf|eot|svg)$ {
        add_header Access-Control-Allow-Origin *;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}