server {
    listen 80;
    server_name {{SERVER_NAME}};
    charset utf-8;

    # 静态文件路径（指向 Vite 构建后的 dist 目录）
    root /mnt/disk1/zeroant/home_web;
    index index.html;

    # 启用 gzip 压缩
    gzip on;
    gzip_types text/css application/javascript;

    # 处理 SPA 路由：所有路由返回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 生产环境开启 HTTP 跳转 HTTPS
    # {{REWRITE_HTTPS}}
    # 如启用，建议：
    # return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name {{SERVER_NAME}};
    client_max_body_size 30M;
    client_header_buffer_size 16K;
    large_client_header_buffers 4 64K;

    root /mnt/disk1/zeroant/home_web;
    index index.html;

    ssl_certificate cert/zeroant.com.pem;
    ssl_certificate_key cert/zeroant.com.key;

    # TLS 配置（现代浏览器兼容）
    ssl_session_timeout 5m;
    ssl_session_cache shared:SSL:10m;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256:EECDH+AESGCM:EDH+AESGCM';
    ssl_prefer_server_ciphers off;

    # HSTS（仅在确认 HTTPS 全站可用后启用）
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    gzip on;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml;
    gzip_min_length 1024;
    gzip_comp_level 6;

    location / {
        try_files $uri $uri/ /index.html;
    }
}