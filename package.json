{
  "name": "zero-ant-home-website",
  "description": "ZeroAnt官方网站",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "vue",
    "typescript",
    "vite",
    "element-plus",
    "zeroant"
  ],
  "engines": {
    "node": ">=20.16.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "build:prod": "NODE_ENV=production vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "validate": "yarn type-check && yarn build && echo 'All checks passed successfully!'",
    "audit": "yarn audit --level moderate",
    "perf": "yarn build:analyze && yarn preview"
  },
  "dependencies": {
    "@intlify/core-base": "^11.3.0",
    "element-plus": "^2.10.4",
    "esbuild": "^0.25.8",
    "vue": "^3.4.21",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^5.0.5",
    "less": "^4.4.0",
    "rollup-plugin-visualizer": "^6.0.3",
    "sharp": "^0.34.3",
    "svgo": "^4.0.0",
    "terser": "^5.43.1",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^5.4.10",
    "vite-plugin-image-optimizer": "^2.0.2",
    "vue-tsc": "^2.0.29"
  },
  "resolutions": {
    "esbuild": ">=0.25.0",
    "semver": ">=5.7.2",
    "brace-expansion": ">=2.0.2",
    "minimatch": ">=9.0.0",
    "vue-tsc": "^2.0.29"
  }
}
