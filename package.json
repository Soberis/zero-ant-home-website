{
  "name": "zero-ant-home-website",
  "description": "ZeroAnt官方网站",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "keywords": [
    "vue",
    "typescript",
    "vite",
    "zeroant"
  ],
  "engines": {
    "node": ">=20.16.0",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "generate:responsive-images": "node scripts/generate-responsive-images.mjs",
    "dev": "node scripts/generate-responsive-images.mjs && vite",
    "build": "node scripts/generate-responsive-images.mjs && vite build && node scripts/generate-site-artifacts.mjs",
    "build:analyze": "node scripts/generate-responsive-images.mjs && cross-env ANALYZE=true vite build && node scripts/generate-site-artifacts.mjs",
    "build:prod": "node scripts/generate-responsive-images.mjs && cross-env NODE_ENV=production vite build && node scripts/generate-site-artifacts.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-check.mjs",
    "test:node": "vitest --config vitest.node.config.ts --run",
    "test:browser:install": "playwright install chromium",
    "test:browser": "vitest --config vitest.config.ts --run",
    "test:browser:watch": "vitest --config vitest.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "vue-tsc --noEmit",
    "validate": "yarn lint && yarn type-check && yarn build && yarn smoke && echo 'All checks passed successfully!'",
    "audit": "yarn audit --level moderate",
    "perf": "yarn build:analyze && yarn preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/outfit": "^5.2.8",
    "vue": "^3.5.33",
    "vue-i18n": "^11.3.0",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.0.15",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/browser": "3.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.0",
    "globals": "^17.5.0",
    "playwright": "1.59.1",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "sharp": "^0.34.3",
    "svgo": "^4.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.55.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^5.4.21",
    "vite-plugin-image-optimizer": "^2.0.2",
    "vitest": "3.2.4",
    "vitest-browser-vue": "1.1.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  },
  "resolutions": {
    "vue-tsc": "^3.2.7",
    "vite": "^5.4.21"
  }
}
